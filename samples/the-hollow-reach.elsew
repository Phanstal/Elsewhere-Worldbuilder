      "type": "Building",
      "x": 320,
      "y": 250,
      "description": "A low stone inn built around a chimney that never quite goes out."
    },
    {
      "id": 103,
      "title": "Known Roads",
      "type": "Map",
      "x": 780,
      "y": 250,
      "description": "The surveyed routes out of the valley, inked in a careful hand."
    },
    {
      "id": 104,
      "title": "Mira Vale",
      "type": "Character",
      "x": 320,
      "y": 470,
      "description": "A cartographer who charts the roads nobody else will walk."
    },
    {
      "id": 105,
      "title": "Ashen Court",
      "type": "Faction",
      "x": 780,
      "y": 470,
      "description": "Keepers of the old crossings. They remember every road that was closed."
    },
    {
      "id": 106,
      "title": "The Long Silence",
      "type": "Event",
      "x": 550,
      "y": 550,
      "description": "The winter the roads emptied and the valley stopped hearing from the coast."
    },
