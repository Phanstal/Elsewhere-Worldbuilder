      "title": "The Hollow Reach",
      "type": "Space",
      "x": 550,
      "y": 340,
      "width": 720,
      "height": 460,
      "description": "A sheltered valley at the edge of the known roads, where the old maps stop and the weather begins.",
      "backgroundColor": "#e6edf0"
    },
    {
